---
import { machines } from '../data/site';
---
<section id="maquinas" class="bg-white py-20">
  <div class="mx-auto max-w-6xl px-5">
    <h2 class="text-4xl md:text-5xl">Máquinas y procesos</h2>
    <p class="mt-3 max-w-xl text-steel-600">Lo que tenemos en el taller, para que sepas si podemos fabricar tu pieza.</p>
    <div class="mt-10 divide-y divide-steel-200 border-y border-steel-200">
      {machines.map((m) => (
        <article class="grid items-center gap-6 py-6 md:grid-cols-12">
          <div class="ph h-32 rounded md:col-span-3">Foto: {m.name}</div>
          <div class="md:col-span-6">
            <h3 class="text-2xl">{m.name}</h3>
            <p class="mt-1 text-steel-600">{m.desc}</p>
          </div>
          <p class="text-sm font-medium text-plano md:col-span-3 md:text-right">{m.cap}</p>
        </article>
      ))}
    </div>
  </div>
</section>
