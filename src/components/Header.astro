---
import { site, nav } from '../data/site';
---
<header class="sticky top-0 z-50 border-b border-steel-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="#" class="font-display text-2xl leading-none text-steel-900">
      {site.name} <span class="text-brand">{site.tagline}</span>
    </a>
    <nav class="hidden gap-7 text-sm font-medium md:flex">
      {nav.map(([l, h]) => <a href={h} class="hover:text-brand">{l}</a>)}
    </nav>
    <a href="#contacto" class="rounded bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-brand-dark">Cotizar</a>
  </div>
</header>
